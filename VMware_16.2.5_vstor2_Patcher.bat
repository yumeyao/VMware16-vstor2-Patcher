function Show-Header {
    Clear-Host
    Write-Host "=================================================================" -ForegroundColor Cyan
    Write-Host "       VMware Workstation 16.2.5 vstor2 Disk Mount Patcher       " -ForegroundColor White
    Write-Host "=================================================================" -ForegroundColor Cyan
    Write-Host "Purpose : Restores native VMDK mounting capabilities gutted in 16.2.x" -ForegroundColor Gray
    Write-Host "Target  : Official 16.2.5 Full Installer (EXE) or Standalone (MSI)" -ForegroundColor Gray
    Write-Host "Driver  : Rollback to 16.1.2 WHQL Signed Driver (sys + inf + cat)" -ForegroundColor Gray
    Write-Host "Mode    : In-place deterministic binary patching (Zero file bloat)" -ForegroundColor Gray
    Write-Host "-----------------------------------------------------------------" -ForegroundColor Cyan
    Write-Host ""
}

$HASH_EXE = "380b0fa8a0f37ade496573cdc2ad922d3985bc83664f94431a9e513444b6c377"
$HASH_MSI = "a21847666ab2f8d2f81782d60e16e057709d87cd827ceab10906f3616e29d62d"
$VSTOR_CAB =

function Write-Bytes($fs, [long]$offset, [byte[]]$data) {
    [void]$fs.Seek($offset, [System.IO.SeekOrigin]::Begin)
    $fs.Write($data, 0, $data.Length)
}

function Shift-Right($fs, [long]$src, [long]$dst, [long]$len) {
    $bufSize = 8 * 1024 * 1024
    $buf = New-Object byte[] $bufSize
    $remaining = $len
    while ($remaining -gt 0) {
        $n = [Math]::Min($bufSize, $remaining)
        [void]$fs.Seek($src + $remaining - $n, [System.IO.SeekOrigin]::Begin)
        $r = $fs.Read($buf, 0, $n)
        [void]$fs.Seek($dst + $remaining - $n, [System.IO.SeekOrigin]::Begin)
        $fs.Write($buf, 0, $r)
        $remaining -= $n
    }
}

function Apply-Patch($fs, [long]$baseOffset, [byte[]]$cab) {
    # driver cabinet
    Write-Bytes $fs ($baseOffset + 0x0ABAF000) ([byte[]]($cab[0..4095]))
    Write-Bytes $fs ($baseOffset + 0x0ABAE000) ([byte[]]($cab[4096..8191]))
    Write-Bytes $fs ($baseOffset + 0x0ABB0000) ([byte[]]($cab[8192..12287]))
    Write-Bytes $fs ($baseOffset + 0x0ABB1000) ([byte[]]($cab[12288..16383]))
    Write-Bytes $fs ($baseOffset + 0x0ABB2000) ([byte[]]($cab[16384..20479]))
    Write-Bytes $fs ($baseOffset + 0x0ABB3000) ([byte[]]($cab[20480..24575]))
    Write-Bytes $fs ($baseOffset + 0x0ABB4000) ([byte[]]($cab[24576..28671]))
    Write-Bytes $fs ($baseOffset + 0x0ABB5000) ([byte[]]($cab[28672..32767]))
    Write-Bytes $fs ($baseOffset + 0x0ABB6000) ([byte[]]($cab[32768..36863]))
    Write-Bytes $fs ($baseOffset + 0x24A07000) ([byte[]]($cab[36864..44176]))
    Write-Bytes $fs ($baseOffset + 0x24A08C91) (New-Object byte[] 879)

    # fixed fields
    Write-Bytes $fs ($baseOffset + 0x0A801ED4) ([System.BitConverter]::GetBytes([uint32]150022))
    Write-Bytes $fs ($baseOffset + 0x24592818) ([System.BitConverter]::GetBytes([uint32]150023))
    Write-Bytes $fs ($baseOffset + 0x2459281C) ([System.BitConverter]::GetBytes([uint32]4294967294))
    Write-Bytes $fs ($baseOffset + 0x000024F8) ([System.BitConverter]::GetBytes([uint64]44177))
    Write-Bytes $fs ($baseOffset + 0x23E14E96) ([System.BitConverter]::GetBytes([uint32]2147531976))
    Write-Bytes $fs ($baseOffset + 0x23E14E9A) ([System.BitConverter]::GetBytes([uint32]2147538240))
    Write-Bytes $fs ($baseOffset + 0x23E14E9E) ([System.BitConverter]::GetBytes([uint32]2147494306))
    Write-Bytes $fs ($baseOffset + 0x23E14EA2) ([System.BitConverter]::GetBytes([uint32]2147485937))
    Write-Bytes $fs ($baseOffset + 0x23C3C688) ([System.BitConverter]::GetBytes([uint32]3631393355))
    Write-Bytes $fs ($baseOffset + 0x23C3CB68) ([System.BitConverter]::GetBytes([uint32]4044618924))
    Write-Bytes $fs ($baseOffset + 0x23D48048) ([System.BitConverter]::GetBytes([uint32]74066290))
    Write-Bytes $fs ($baseOffset + 0x23D48528) ([System.BitConverter]::GetBytes([uint32]2771560546))
    Write-Bytes $fs ($baseOffset + 0x23C3C68C) ([System.BitConverter]::GetBytes([uint32]326275443))
    Write-Bytes $fs ($baseOffset + 0x23C3CB6C) ([System.BitConverter]::GetBytes([uint32]33100417))
    Write-Bytes $fs ($baseOffset + 0x23D4804C) ([System.BitConverter]::GetBytes([uint32]838777713))
    Write-Bytes $fs ($baseOffset + 0x23D4852C) ([System.BitConverter]::GetBytes([uint32]891584957))
    Write-Bytes $fs ($baseOffset + 0x23D33D74) ([byte[]](0x36, 0x2E, 0x32, 0x2E, 0x30, 0x2E, 0x35, 0x31, 0x31))
}

function Get-Sha256([string]$path) {
    $sha = [System.Security.Cryptography.SHA256]::Create()
    $stream = [System.IO.File]::OpenRead($path)
    try {
        return -join ($sha.ComputeHash($stream) | ForEach-Object { "{0:x2}" -f $_ })
    } finally {
        $stream.Close()
        $sha.Dispose()
    }
}

function Select-Target([string[]]$argv) {
    if ($argv.Count -gt 0 -and (-not [string]::IsNullOrEmpty($argv[0]))) {
        return $argv[0].Trim('"')
    }

    Add-Type -AssemblyName System.Windows.Forms
    $dialog = New-Object System.Windows.Forms.OpenFileDialog
    $dialog.Title = "Select VMware Workstation 16.2.5 Installer (EXE or MSI)"
    $dialog.Filter = "VMware 16.2.5 Installer (*.exe;*.msi)|*.exe;*.msi|All Files (*.*)|*.*"
    $dialog.InitialDirectory = [System.IO.Path]::GetDirectoryName($env:SELF)

    if ($dialog.ShowDialog() -eq [System.Windows.Forms.DialogResult]::OK) {
        return $dialog.FileName
    }
    return $null
}

function ExitWithPause([int]$code) {
    Write-Host ""
    Write-Host "Press Enter to exit..." -ForegroundColor Cyan
    [Console]::ReadLine() | Out-Null
    exit $code
}

function Invoke-Main {
    param([string[]]$argv)
    $ErrorActionPreference = 'Stop'

    Show-Header

    $targetFile = Select-Target $argv
    if ([string]::IsNullOrEmpty($targetFile)) {
        Write-Host "[-] Operation cancelled by user." -ForegroundColor Red
        ExitWithPause 0
    }

    if (-not (Test-Path -LiteralPath $targetFile)) {
        Write-Host "[-] Error: Specified file does not exist: $targetFile" -ForegroundColor Red
        ExitWithPause 1
    }

    $hash = Get-Sha256 $targetFile

    if ($hash -eq $HASH_EXE) {
        $isExe = $true
    }
    elseif ($hash -eq $HASH_MSI) {
        $isExe = $false
    }
    else {
        Write-Host ""
        Write-Host "[-] Error: SHA256 mismatch!" -ForegroundColor Red
        Write-Host "    The selected file is NOT an official VMware 16.2.5 installer." -ForegroundColor Red
        ExitWithPause 2
    }

    Copy-Item -LiteralPath $targetFile -Destination "$targetFile.bak" -Force

    try {
        $fs = [System.IO.File]::Open($targetFile, [System.IO.FileMode]::Open, [System.IO.FileAccess]::ReadWrite)
        try {
            if ($isExe) {
                $len = $fs.Length
                Shift-Right $fs 0x24BB6B2C 0x24BB8B2C ($len - 0x24BB6B2C)
                Apply-Patch $fs 0x1AFB2C $VSTOR_CAB
                Write-Bytes $fs 0x1AF90C ([System.BitConverter]::GetBytes([uint64]614502400))
                Write-Bytes $fs 0x1A8 (New-Object byte[] 8)
                Write-Bytes $fs 0x11297 ([byte[]](0xEB, 0x0F))
                $fs.SetLength(645466852)
            }
            else {
                Apply-Patch $fs 0 $VSTOR_CAB
            }
            $fs.Flush()
        }
        finally {
            $fs.Close()
            $fs.Dispose()
        }
    }
    catch {
        Write-Host ""
        Write-Host "[-] Error: patching failed. Restore from the .bak file." -ForegroundColor Red
        Write-Host "    $($_.Exception.Message)" -ForegroundColor Red
        ExitWithPause 1
    }

    Write-Host ""
    Write-Host "[+] SUCCESS: The file has been successfully patched!" -ForegroundColor Green
    Write-Host "    Original file backed up as: $([System.IO.Path]::GetFileName($targetFile)).bak" -ForegroundColor Gray
    ExitWithPause 0
}

